# Copy to .env and fill in. Server-side only: never copy the secret into dist/ or commit .env.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
# Signs the membership and instalment tokens the server hands to browsers. Keep it
# when you rotate the Razorpay secret, or paid memberships lose their discount.
# Generate with: openssl rand -hex 32
PAYMENT_TOKEN_SECRET=
# Chat assistant on Cloudflare Workers AI (free daily allowance). Dashboard → Workers AI →
# Use REST API: copy the Account ID and create a "Workers AI" API token. Without them the
# assistant answers with links to matching pages instead.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: CHAT_MODEL, CHAT_FALLBACK_MODEL, CHAT_DAILY_NEURONS (default 9000)

# WhatsApp Business Cloud API (Meta). Leave blank to keep WhatsApp off. See README → WhatsApp.
# Permanent System User token (Business Settings → Users → System users) with whatsapp_business_messaging
# and whatsapp_business_management. Never the 24-hour test token.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# App settings → Basic. The secret checks that webhooks really come from Meta.
META_APP_ID=
META_APP_SECRET=
# Any random string; paste the same value into the webhook settings in Meta.
WEBHOOK_VERIFY_TOKEN=
# Protects /api/whatsapp/send, /templates, /phone and /partner. Send as header x-api-key.
# Generate with: openssl rand -hex 32
WHATSAPP_API_KEY=
# Client signup page (/connect-whatsapp): the Facebook Login for Business configuration ID with Embedded Signup.
WHATSAPP_SIGNUP_CONFIG_ID=
# Optional: GRAPH_API_VERSION (default v26.0), DEFAULT_COUNTRY_CODE (default 91),
# WHATSAPP_BOT=on (auto-reply menu on our own number),
# FORWARD_WEBHOOK_URL (copy every event to another backend) + FORWARD_WEBHOOK_SECRET (Bearer token the sink must check),
# WHATSAPP_CREDIT_LINE_ID (Solution Partner only: share our credit line when onboarding a client)

# Set to 1 only behind a local reverse proxy that appends the real peer IP.
TRUST_LOCAL_PROXY=0

# Offers need Node 22.13+ and a persistent private SQLite path outside dist.
OFFER_DB_PATH=var/offers.sqlite
# Generate a secret with openssl rand -hex 32 for admin offer leads.
OFFER_ADMIN_KEY=

# Shared application data. Requires Node 22.13+ and a persistent private path.
APP_DB_PATH=var/app.sqlite
# Used only to create the first administrator. No default admin password is shipped.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Optional loopback-only simulated checkout for development. Keep disabled on hosted deployments.
ALLOW_DEMO_CHECKOUT=0

# Optional public YouTube channel statistics for Vintorent
YOUTUBE_API_KEY=
